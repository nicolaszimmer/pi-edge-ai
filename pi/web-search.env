# Web search for the pi-llm service, installed to /etc/pi-llm/web-search.env
# (readable by root only, it holds your API key).
# ./web-search.sh on | off | setup | test manages it. After editing by hand:
#   sudo systemctl restart pi-llm

# Makes llama-server start the web tools from mcp.json.
# ./web-search.sh off comments this line out, on puts it back.
LLAMA_ARG_MCP_SERVERS_CONFIG=/etc/pi-llm/mcp.json

# Search engine: tavily, brave or searxng
WEB_SEARCH_ENGINE=
TAVILY_API_KEY=
BRAVE_API_KEY=
# Your own SearXNG instance, with the JSON format enabled in its settings.yml
SEARXNG_URL=

# Results per search, and how much of a fetched page the model reads.
# On a Pi, every 1,000 characters cost a few seconds of prompt processing.
WEB_SEARCH_RESULTS=5
WEB_FETCH_MAX_CHARS=6000
