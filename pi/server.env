# Settings for the pi-llm service, installed to /etc/pi-llm/server.env
# After editing:  sudo systemctl restart pi-llm

# 0.0.0.0 = reachable from your home network. Use 127.0.0.1 to allow only
# local access (for example when you put Caddy or Tailscale in front).
LLM_HOST=0.0.0.0
LLM_PORT=8080

# Extra llama-server router flags, space separated. Examples:
#   --no-ui                       disable the built-in web UI (API only)
#   --sleep-idle-seconds 1800     unload the model after 30 min idle (frees RAM)
#   --metrics                     Prometheus metrics at /metrics
LLM_EXTRA_ARGS=
